# ProcessLens Backend Environment Variables
# Copy this file to .env for local overrides (never commit .env to source control).

# CORS allowed origins (comma-separated list of allowed origins)
# In production, set this to your exact frontend origin(s), e.g. https://processlens.example.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://testserver

# Optional LLM Provider Configuration
# When LLM_API_KEY is not set or empty, ProcessLens operates entirely deterministically
# using rule-based templates and evidence-grounded logic.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30.0

# Authentication & Session Security (Phase 11.6)
# Leave blank for a random per-process development secret; set a stable strong secret for staging/production.
AUTH_SECRET_KEY=

# Session lifespan in seconds (default: 28800 = 8 hours)
AUTH_TOKEN_EXPIRE_SECONDS=28800

# Set to true in production behind HTTPS to enforce Secure cookie flag
AUTH_SECURE_COOKIE=false

# Comma-separated exact IP addresses of reverse proxies allowed to supply X-Forwarded-For.
TRUSTED_PROXY_IPS=

# Deployment environment (development / test / staging / production)
ENVIRONMENT=development

# Initial Developer Administrator Account (Provisioned on server startup; change in production)
DEV_ADMIN_EMAIL=dev@processlens.internal
DEV_ADMIN_PASSWORD=

# Initial Evaluation Customer Account (Change or disable in production)
DEMO_CUSTOMER_EMAIL=customer@processlens.com
DEMO_CUSTOMER_PASSWORD=

# Durable Storage Configuration (Phase 11.8)
# Path to SQLite database for durable accounts, session revocation, and cross-worker rate limits on one host.
# Leave empty for process-local development storage; use Redis or equivalent for multi-host rate limits.
USER_STORE_DB_PATH=

# Password Recovery Email Delivery (Phase 11.8)
# Set to 'true' only when a real SMTP mail provider is configured.
# When false or unconfigured, self-service recovery returns an honest 501 Not Implemented status.
EMAIL_DELIVERY_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=


