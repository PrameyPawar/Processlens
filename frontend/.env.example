# ProcessLens Frontend Environment Variables
# Copy this file to .env or .env.production for deployment-specific overrides.

# Backend API base URL
# Leave blank or omit to use same-origin relative URLs (/api/v1 and /health),
# which is recommended when frontend and backend are served behind a reverse proxy (e.g., Nginx).
# Set to an absolute URL (e.g., http://localhost:8000 or https://api.processlens.example.com)
# if the frontend is hosted separately on a distinct domain or port without a proxy.
VITE_API_URL=
